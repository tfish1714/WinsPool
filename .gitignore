# Python
__pycache__/
*.py[cod]
*.pyc
.pytest_cache/
.venv/
venv/

# Environment & credentials — NEVER commit these
.env
firebase_credentials.json
*.json.key

# Local data cache
.local_db/

# Debug / scratch files
debug/

# Log output
logs/

# Build artifacts
*.db
dist/
build/

# Documentation
docs/

# Deployment Scripts
deploy/

# Raw data (large, not committed)
rawdata/

# Claude Code local session data
.claude/

# Trained model binaries (large — use model_registry.json to track versions)
models/*.keras
models/*.pkl
models/walkforward/

# ML reports (generated, not source)
reports/

# Design Files
design/

# Superpowers skill scratch space (brainstorm sessions, SDD workspaces) -- never source
.superpowers/

# Graphify knowledge graph -- regenerable cache/tool state, not source.
# graph.json itself (and GRAPH_REPORT.md/manifest.json) stay trackable --
# .gitattributes sets a merge driver for graph.json, which only matters if
# it's actually committed.
graphify-out/cache/
graphify-out/.obsidian/
graphify-out/obsidian/
graphify-out/.graphify_*
graphify-out/cost.json
graphify-out/graph.html

# Stray Obsidian vault (personal notes, not app source)
WinsPool/
