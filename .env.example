# ============================================================
# WinsPool — Environment Variables
# Copy this to .env and fill in your values.
# NEVER commit .env or firebase_credentials.json to git.
# ============================================================

# --- Firebase (Production / Cloud Run) ----------------------
# Base64-encode your firebase_credentials.json:
#   python -c "import base64; print(base64.b64encode(open('firebase_credentials.json','rb').read()).decode())"
# Then paste the output here.
FIREBASE_CREDENTIALS=<base64-encoded-service-account-json>

# --- Runtime ------------------------------------------------
# Set to True to use .local_db/*.pkl instead of Firestore
USE_LOCAL_DATA=True
DEBUG_PAGE_LOAD=True

# Port the FastAPI server listens on
PORT=8000
