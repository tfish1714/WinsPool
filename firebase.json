{
    "hosting": {
        "public": "static",
        "ignore": [
            "firebase.json",
            "**/.*",
            "**/node_modules/**"
        ],
        "rewrites": [
            {
                "source": "/api/**",
                "run": {
                    "serviceId": "winspool-api",
                    "region": "us-central1"
                }
            },
            {
                "source": "/ws/**",
                "run": {
                    "serviceId": "winspool-api",
                    "region": "us-central1"
                }
            },
            {
                "source": "/admin",
                "run": {
                    "serviceId": "winspool-api",
                    "region": "us-central1"
                }
            },
            {
                "source": "**",
                "destination": "/index.html"
            }
        ]
    },
    "functions": [
        {
            "source": "functions",
            "codebase": "default",
            "ignore": [
                ".venv",
                "**/.*",
                "**/node_modules/**"
            ],
            "runtime": "python311"
        }
    ]
}